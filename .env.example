# Copy this file to .env. Never commit .env.

BRAVE_SEARCH_API_KEY=

# Gemini auth key from Google AI Studio. Used when LLM_API_KEY is unset.
GEMINI_API_KEY=

# Optional override when you switch away from Gemini.
# LLM_API_KEY=

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

DISCORD_WEBHOOK_NEWS=
DISCORD_WEBHOOK_SCHOLARSHIP=
DISCORD_WEBHOOK_EVENTS=

BRIEFING_LANGUAGE=es
BRIEFING_MAX_RESULTS=5
SEARCH_MAX_RESULTS=10
DATABASE_PATH=data/lantern.db
